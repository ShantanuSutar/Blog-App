# Optional dedicated test database. The database name must contain "test".
# When omitted, the test runner may use a local development database, but all
# objects are still created in a unique, temporary PostgreSQL schema.
TEST_DATABASE_URL=postgresql://postgres:replace-with-test-password@localhost:5432/unsaid_test

# Test-only values. The runner supplies safe defaults for these automatically.
JWT_SECRET=replace-with-a-test-secret-at-least-32-bytes-long
POSTGRES_SSL=disable
