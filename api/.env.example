PORT=8800
NODE_ENV=development

# Prefer DATABASE_URL in hosted environments. The individual POSTGRES_* values
# are used as a local-compatible fallback.
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blog_app
# Supported values: disable, require (default), verify-full
POSTGRES_SSL=disable

# Use at least 32 cryptographically random bytes in production.
JWT_SECRET=replace-with-a-long-random-secret
# Access tokens must expire between 1 second and 7 days.
JWT_EXPIRES_IN=1h
# Supported range: 10-14. Existing lower-cost hashes remain verifiable.
BCRYPT_ROUNDS=12

# Comma-separated browser origins. Requests without an Origin header remain
# allowed for non-browser clients and health checks.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8800

# Leave empty when the API is directly exposed. When deployed behind a reverse
# proxy, list only its trusted addresses/subnets (for example: loopback or
# 10.0.0.0/8). Never use `true`, `*`, or an all-address CIDR.
TRUST_PROXY=

# JSON includes rich-text post bodies. Uploads have separate 5 MB Multer limits.
JSON_BODY_LIMIT=2mb

# In-memory rate limits. Values can be tuned per deployment without code changes.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
INTERACTION_RATE_LIMIT_WINDOW_MS=900000
INTERACTION_RATE_LIMIT_MAX=120
COMMENT_RATE_LIMIT_WINDOW_MS=900000
COMMENT_RATE_LIMIT_MAX=30
NEWSLETTER_RATE_LIMIT_WINDOW_MS=3600000
NEWSLETTER_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
